状态机 = []

函数 状态机.新建(名, 定义) {
局部 m = [名 = 名, 定义 = 定义, 当前 = 定义.初始, 历史 = []];
函数 m.转至(新状态) {
如果 非 m.定义.状态 或 非 m.定义.状态[新状态] 那么 {
写日志("[状态机] " .. m.名 .. " 未知状态 " .. 转文本(新状态));
返回 假;
}
如果 非 m.定义.状态[m.当前] 那么 {
写日志("[状态机] " .. m.名 .. " 当前状态缺失 " .. 转文本(m.当前));
返回 假;
}
如果 m.当前 == 新状态 那么 { 返回 真; }
局部 离开 = m.定义.状态[m.当前].离开;
如果 离开 那么 { 离开(); }
m.历史[#m.历史 + 1] = m.当前 .. "->" .. 新状态;
写日志("[状态机] " .. m.名 .. ": " .. m.当前 .. " -> " .. 新状态);
m.当前 = 新状态;
局部 进入 = m.定义.状态[新状态].进入;
如果 进入 那么 { 进入(); }
返回 真;
}
函数 m.更新(...) {
局部 节点 = m.定义.状态[m.当前];
如果 节点 且 节点.更新 那么 { 返回 节点.更新(...); }
}
函数 m.是(状态) { 返回 m.当前 == 状态; }
函数 m.取历史() { 返回 m.历史; }
返回 m;
}
