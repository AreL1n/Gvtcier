全局 已就绪 = 假;
全局 棋盘 = [];
全局 列数 = 10;
全局 行数 = 20;
全局 当前形 = 0;
全局 下一形 = 0;
全局 方块X = 0;
全局 方块Y = 0;
全局 朝向 = 0;
全局 下落计时 = 0.0;
全局 下落间隔 = 0.8;
全局 横移计时 = 0.0;
全局 横移间隔 = 0.08;
全局 得分 = 0;
全局 等级 = 1;
全局 消行总数 = 0;
全局 用时 = 0.0;
全局 结束 = 假;
全局 暂停 = 假;
全局 提示文字 = "";
全局 提示计时 = 0.0;

当二维开始时() {
函数 点(x, y) {
局部 p = [];
p[1] = x;
p[2] = y;
返回 p;
}

函数 拼(块, x1, y1, x2, y2, x3, y3, x4, y4) {
表.插入(块, 点(x1, y1));
表.插入(块, 点(x2, y2));
表.插入(块, 点(x3, y3));
表.插入(块, 点(x4, y4));
返回 块;
}

函数 基础形状(序号) {
局部 块 = [];
如果 序号 == 1 那么 { 返回 拼(块, 0,1, 1,1, 2,1, 3,1); }
如果 序号 == 2 那么 { 返回 拼(块, 0,0, 0,1, 1,0, 1,1); }
如果 序号 == 3 那么 { 返回 拼(块, 0,0, 1,0, 2,0, 1,1); }
如果 序号 == 4 那么 { 返回 拼(块, 1,0, 2,0, 0,1, 1,1); }
如果 序号 == 5 那么 { 返回 拼(块, 0,0, 1,0, 1,1, 2,1); }
如果 序号 == 6 那么 { 返回 拼(块, 0,0, 0,1, 1,1, 2,1); }
返回 拼(块, 2,0, 0,1, 1,1, 2,1);
}

函数 旋转格(gx, gy, 角) {
局部 r = [];
如果 角 == 1 那么 { r[1] = -gy; r[2] = gx; 返回 r; }
如果 角 == 2 那么 { r[1] = -gx; r[2] = -gy; 返回 r; }
如果 角 == 3 那么 { r[1] = gy; r[2] = -gx; 返回 r; }
r[1] = gx;
r[2] = gy;
返回 r;
}

函数 取形状() {
局部 板 = 基础形状(当前形);
局部 out = [];
循环 i = 1, #板 执行 {
局部 r = 旋转格(板[i][1], 板[i][2], 朝向);
表.插入(out, 点(r[1], r[2]));
}
局部 最小x = 99;
局部 最小y = 99;
循环 i = 1, #out 执行 {
如果 out[i][1] < 最小x 那么 { 最小x = out[i][1]; }
如果 out[i][2] < 最小y 那么 { 最小y = out[i][2]; }
}
循环 i = 1, #out 执行 {
out[i][1] = out[i][1] - 最小x;
out[i][2] = out[i][2] - 最小y;
}
返回 out;
}

函数 预览形状(序号) {
局部 保存 = 当前形;
局部 保存朝向 = 朝向;
当前形 = 序号;
朝向 = 0;
局部 s = 取形状();
当前形 = 保存;
朝向 = 保存朝向;
返回 s;
}

函数 占位(x, y) {
如果 x < 0 或 x >= 列数 那么 { 返回 真; }
如果 y >= 行数 那么 { 返回 真; }
如果 y < 0 那么 { 返回 假; }
返回 棋盘[y * 列数 + x + 1] ~= 0;
}

函数 能放(形状, px, py) {
循环 i = 1, #形状 执行 {
如果 占位(px + 形状[i][1], py + 形状[i][2]) 那么 { 返回 假; }
}
返回 真;
}

函数 落点行() {
局部 形 = 取形状();
局部 y = 方块Y;
当 能放(形, 方块X, y + 1) 执行 { y = y + 1; }
返回 y;
}

函数 设提示(文字) {
提示文字 = 文字;
提示计时 = 1.2;
}

函数 新方块() {
当前形 = 下一形;
如果 当前形 == 0 那么 { 当前形 = 获取_随机整数(1, 7); }
下一形 = 获取_随机整数(1, 7);
朝向 = 0;
方块X = 列数 / 2 - 2;
方块Y = 0;
下落计时 = 0.0;
局部 形 = 取形状();
如果 能放(形, 方块X, 方块Y) == 假 那么 {
结束 = 真;
执行_打印("游戏结束 得分=" .. 转文本(得分));
}
}

函数 清空棋盘() {
棋盘 = [];
循环 i = 1, 列数 * 行数 执行 { 表.插入(棋盘, 0); }
得分 = 0;
等级 = 1;
消行总数 = 0;
用时 = 0.0;
下落间隔 = 0.8;
下落计时 = 0.0;
结束 = 假;
暂停 = 假;
提示文字 = "";
提示计时 = 0.0;
当前形 = 0;
下一形 = 0;
新方块();
}

函数 更新速度() {
局部 基准 = 0.8 - (等级 - 1) * 0.07;
局部 加速 = 数学.向下取整(得分 / 500) * 0.01;
下落间隔 = 基准 - 加速;
如果 下落间隔 < 0.06 那么 { 下落间隔 = 0.06; }
}

函数 锁定(形状) {
循环 i = 1, #形状 执行 {
局部 gx = 方块X + 形状[i][1];
局部 gy = 方块Y + 形状[i][2];
如果 gy >= 0 且 gy < 行数 且 gx >= 0 且 gx < 列数 那么 {
棋盘[gy * 列数 + gx + 1] = 当前形;
}
}
局部 消行数 = 0;
局部 row = 行数 - 1;
当 row >= 0 执行 {
局部 满 = 真;
循环 cx = 0, 列数 - 1 执行 {
如果 棋盘[row * 列数 + cx + 1] == 0 那么 { 满 = 假; }
}
如果 满 那么 {
消行数 = 消行数 + 1;
局部 up = row;
当 up >= 1 执行 {
循环 cx = 0, 列数 - 1 执行 {
棋盘[up * 列数 + cx + 1] = 棋盘[(up - 1) * 列数 + cx + 1];
}
up = up - 1;
}
循环 cx = 0, 列数 - 1 执行 { 棋盘[cx + 1] = 0; }
} 否则 {
row = row - 1;
}
}
如果 消行数 > 0 那么 {
消行总数 = 消行总数 + 消行数;
得分 = 得分 + 消行数 * 消行数 * 100 * 等级;
如果 得分 >= 2100000000 那么 {
得分 = 2100000000;
结束 = 真;
设提示("分数上限");
执行_打印("分数到达上限，游戏结束");
返回;
}
局部 新等级 = 数学.向下取整(消行总数 / 10) + 1;
如果 新等级 ~= 等级 那么 {
等级 = 新等级;
设提示("等级 " .. 转文本(等级));
}
如果 消行数 == 4 那么 { 设提示("四连消!"); }
否则如果 消行数 == 3 那么 { 设提示("三连消"); }
}
更新速度();
新方块();
}

函数 移动(dx) {
局部 形 = 取形状();
如果 能放(形, 方块X + dx, 方块Y) 那么 {
方块X = 方块X + dx;
返回 真;
}
返回 假;
}

函数 转动() {
局部 试 = 0;
当 试 < 4 执行 {
朝向 = (朝向 + 1) % 4;
局部 形 = 取形状();
如果 能放(形, 方块X, 方块Y) 那么 { 返回 真; }
如果 能放(形, 方块X - 1, 方块Y) 那么 { 方块X = 方块X - 1; 返回 真; }
如果 能放(形, 方块X + 1, 方块Y) 那么 { 方块X = 方块X + 1; 返回 真; }
如果 能放(形, 方块X, 方块Y - 1) 那么 { 方块Y = 方块Y - 1; 返回 真; }
试 = 试 + 1;
}
朝向 = 0;
返回 假;
}

函数 下移一格() {
局部 形 = 取形状();
如果 能放(形, 方块X, 方块Y + 1) 那么 {
方块Y = 方块Y + 1;
返回 真;
}
锁定(形);
返回 假;
}

函数 硬降() {
局部 目标 = 落点行();
局部 距离 = 目标 - 方块Y;
方块Y = 目标;
得分 = 得分 + 距离 * 2;
锁定(取形状());
}

函数 块色(序号) {
如果 序号 == 1 那么 { 返回 [0.25, 0.85, 0.95]; }
如果 序号 == 2 那么 { 返回 [0.95, 0.85, 0.25]; }
如果 序号 == 3 那么 { 返回 [0.65, 0.35, 0.95]; }
如果 序号 == 4 那么 { 返回 [0.35, 0.90, 0.45]; }
如果 序号 == 5 那么 { 返回 [0.95, 0.35, 0.35]; }
如果 序号 == 6 那么 { 返回 [0.35, 0.55, 0.95]; }
返回 [0.95, 0.60, 0.25];
}

函数 亮色(值) {
局部 v = 值 + 0.22;
如果 v > 1.0 那么 { 返回 1.0; }
返回 v;
}

函数 画格(px, py, 序号, 尺寸) {
如果 序号 == 空 或 序号 == 0 那么 { 返回; }
局部 c = 块色(序号);
绘制_矩形(px + 1, py + 1, 尺寸 - 2, 尺寸 - 2, c[1], c[2], c[3], 1.0);
局部 亮 = 数学.向下取整(尺寸 * 0.16);
绘制_矩形(px + 1, py + 1, 尺寸 - 2, 亮, 亮色(c[1]), 亮色(c[2]), 亮色(c[3]), 1.0);
}

函数 画幽灵(px, py, 尺寸) {
局部 边 = 数学.向下取整(尺寸 * 0.12);
如果 边 < 1 那么 { 边 = 1; }
绘制_矩形(px + 1, py + 1, 尺寸 - 2, 边, 0.35, 0.35, 0.40, 0.75);
绘制_矩形(px + 1, py + 尺寸 - 1 - 边, 尺寸 - 2, 边, 0.35, 0.35, 0.40, 0.75);
绘制_矩形(px + 1, py + 1, 边, 尺寸 - 2, 0.35, 0.35, 0.40, 0.75);
绘制_矩形(px + 尺寸 - 1 - 边, py + 1, 边, 尺寸 - 2, 0.35, 0.35, 0.40, 0.75);
}

函数 两位(值) {
如果 值 < 10 那么 { 返回 "0" .. 转文本(值); }
返回 转文本(值);
}

函数 时间文本() {
局部 总 = 数学.向下取整(用时);
局部 分 = 数学.向下取整(总 / 60);
局部 秒 = 总 - 分 * 60;
返回 两位(分) .. ":" .. 两位(秒);
}

函数 处理输入(dt) {
如果 结束 那么 {
如果 检测_按键刚按下(82) 那么 { 清空棋盘(); }
返回;
}
如果 检测_按键刚按下(80) 那么 {
暂停 = 暂停 == 假;
返回;
}
如果 暂停 那么 { 返回; }

如果 检测_按键刚按下(65) 那么 { 移动(-1); 横移计时 = -横移间隔; }
如果 检测_按键刚按下(68) 那么 { 移动(1); 横移计时 = -横移间隔; }
如果 检测_按键刚按下(87) 那么 { 转动(); }
如果 检测_按键刚按下(32) 那么 { 硬降(); 返回; }

局部 下 = 检测_按键按下(83);
如果 下 那么 {
下落计时 = 下落计时 + dt * 12.0;
} 否则 {
下落计时 = 下落计时 + dt;
}
如果 下落计时 >= 下落间隔 那么 {
下落计时 = 0.0;
下移一格();
}

局部 左 = 检测_按键按下(65);
局部 右 = 检测_按键按下(68);
如果 左 或 右 那么 {
横移计时 = 横移计时 + dt;
如果 横移计时 >= 横移间隔 那么 {
横移计时 = 0.0;
如果 左 那么 { 移动(-1); } 否则 { 移动(1); }
}
} 否则 {
横移计时 = 0.0;
}
}

如果 已就绪 == 假 那么 {
已就绪 = 真;
设置_抗锯齿(真);
清空棋盘();
执行_打印("俄罗斯方块就绪");
}

局部 窗口宽, 窗口高 = 获取_屏幕尺寸();
局部 dt = 获取_帧间隔();
如果 dt > 0.1 那么 { dt = 0.1; }

如果 结束 == 假 且 暂停 == 假 那么 {
用时 = 用时 + dt;
}
如果 提示计时 > 0 那么 { 提示计时 = 提示计时 - dt; }
处理输入(dt);

绘制_矩形(0, 0, 窗口宽, 窗口高, 0.47, 0.48, 0.52, 1.0);

局部 格 = 窗口高 / 26;
局部 板宽 = 列数 * 格;
局部 板高 = 行数 * 格;
局部 板横 = (窗口宽 - 板宽) / 2;
局部 板纵 = (窗口高 - 板高) / 2;

绘制_矩形(板横 - 6, 板纵 - 6, 板宽 + 12, 板高 + 12, 0.13, 0.14, 0.17, 1.0);
绘制_矩形(板横, 板纵, 板宽, 板高, 0.90, 0.91, 0.93, 1.0);

循环 gy = 0, 行数 - 1 执行 {
如果 gy % 2 == 0 那么 {
绘制_矩形(板横, 板纵 + gy * 格, 板宽, 格, 0.85, 0.86, 0.89, 1.0);
}
}
循环 gx = 1, 列数 - 1 执行 {
绘制_矩形(板横 + gx * 格 - 1, 板纵, 1, 板高, 0.78, 0.79, 0.83, 1.0);
}
循环 gy = 1, 行数 - 1 执行 {
绘制_矩形(板横, 板纵 + gy * 格 - 1, 板宽, 1, 0.78, 0.79, 0.83, 1.0);
}

循环 gy = 0, 行数 - 1 执行 {
循环 gx = 0, 列数 - 1 执行 {
画格(板横 + gx * 格, 板纵 + gy * 格, 棋盘[gy * 列数 + gx + 1], 格);
}
}

如果 结束 == 假 且 当前形 ~= 0 且 暂停 == 假 那么 {
局部 形 = 取形状();
局部 落点 = 落点行();
如果 落点 > 方块Y 那么 {
循环 i = 1, #形 执行 {
局部 gx = 方块X + 形[i][1];
局部 gy = 落点 + 形[i][2];
如果 gy >= 0 那么 {
画幽灵(板横 + gx * 格, 板纵 + gy * 格, 格);
}
}
}
循环 i = 1, #形 执行 {
局部 gx = 方块X + 形[i][1];
局部 gy = 方块Y + 形[i][2];
如果 gy >= 0 那么 {
画格(板横 + gx * 格, 板纵 + gy * 格, 当前形, 格);
}
}
}

局部 预览格 = 格 * 0.85;
局部 预览框 = 预览格 * 4;
局部 侧横 = 板横 + 板宽 + 36;
局部 侧纵 = 板纵 + 24;

绘制_矩形(侧横 - 6, 侧纵 - 6, 预览框 + 12, 预览框 + 12, 0.13, 0.14, 0.17, 1.0);
绘制_矩形(侧横, 侧纵, 预览框, 预览框, 0.90, 0.91, 0.93, 1.0);

如果 下一形 ~= 0 那么 {
局部 形 = 预览形状(下一形);
局部 最右 = 0;
局部 最下 = 0;
循环 i = 1, #形 执行 {
如果 形[i][1] > 最右 那么 { 最右 = 形[i][1]; }
如果 形[i][2] > 最下 那么 { 最下 = 形[i][2]; }
}
局部 块宽 = 最右 + 1;
局部 块高 = 最下 + 1;
局部 偏移横 = (4 - 块宽) / 2.0;
局部 偏移纵 = (4 - 块高) / 2.0;
循环 i = 1, #形 执行 {
局部 px = 侧横 + (形[i][1] + 偏移横) * 预览格;
局部 py = 侧纵 + (3 - 形[i][2] - 偏移纵) * 预览格;
画格(px, py, 下一形, 预览格);
}
}

绘制_文本(侧横, 侧纵 - 70, 1.2, "下一个");

局部 行高 = 60;
局部 信息纵 = 侧纵 + 预览框 + 56;
绘制_文本(侧横, 信息纵, 1.3, "分数  " .. 转文本(得分));
绘制_文本(侧横, 信息纵 + 行高, 1.3, "等级  " .. 转文本(等级));
绘制_文本(侧横, 信息纵 + 行高 * 2, 1.3, "消行  " .. 转文本(消行总数));
绘制_文本(侧横, 信息纵 + 行高 * 3, 1.3, "时间  " .. 时间文本());

局部 左横 = 板横 - 300;
如果 左横 < 20 那么 { 左横 = 20; }
局部 说明行高 = 52;
绘制_文本(左横, 板纵 + 40, 1.8, "俄罗斯方块");
绘制_文本(左横, 板纵 + 140, 1.1, "A D  左右移动");
绘制_文本(左横, 板纵 + 140 + 说明行高, 1.1, "W    旋转");
绘制_文本(左横, 板纵 + 140 + 说明行高 * 2, 1.1, "S    加速下落");
绘制_文本(左横, 板纵 + 140 + 说明行高 * 3, 1.1, "空格 瞬间落地");
绘制_文本(左横, 板纵 + 140 + 说明行高 * 4, 1.1, "P    暂停");
绘制_文本(左横, 板纵 + 140 + 说明行高 * 5, 1.1, "R    重新开始");

如果 提示计时 > 0 那么 {
局部 提示宽, 提示高 = 获取_测量文本(提示文字, 1.4);
绘制_文本(数学.向下取整(板横 + (板宽 - 提示宽) / 2), 板纵 - 60, 1.4, 提示文字);
}

如果 暂停 那么 {
绘制_矩形(板横, 板纵 + 板高 / 2 - 52, 板宽, 104, 0.10, 0.10, 0.13, 0.90);
局部 暂停宽, 暂停高 = 获取_测量文本("暂停", 1.8);
绘制_文本(数学.向下取整(板横 + (板宽 - 暂停宽) / 2), 数学.向下取整(板纵 + 板高 / 2 - 20), 1.8, "暂停");
}

如果 结束 那么 {
绘制_矩形(板横, 板纵 + 板高 / 2 - 90, 板宽, 180, 0.10, 0.10, 0.13, 0.94);
局部 结束宽, 结束高 = 获取_测量文本("游戏结束", 1.5);
绘制_文本(数学.向下取整(板横 + (板宽 - 结束宽) / 2), 数学.向下取整(板纵 + 板高 / 2 - 50), 1.5, "游戏结束");
局部 分文本 = "得分 " .. 转文本(得分);
局部 分宽, 分高 = 获取_测量文本(分文本, 1.2);
绘制_文本(数学.向下取整(板横 + (板宽 - 分宽) / 2), 数学.向下取整(板纵 + 板高 / 2 + 16), 1.2, 分文本);
局部 重文本 = "按 R 重新开始";
局部 重宽, 重高 = 获取_测量文本(重文本, 1.0);
绘制_文本(数学.向下取整(板横 + (板宽 - 重宽) / 2), 数学.向下取整(板纵 + 板高 / 2 + 62), 1.0, 重文本);
}
}
